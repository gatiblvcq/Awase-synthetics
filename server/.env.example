# Backend Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=awase_synthetics
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Deriv API Configuration
DERIV_API_KEY=your_deriv_api_key
DERIV_API_SECRET=your_deriv_api_secret
DERIV_APP_ID=your_deriv_app_id
DERIV_SERVER=green.derivws.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Signal Generation
SIGNALS_PER_DAY_MIN=5
SIGNALS_PER_DAY_MAX=30
SIGNAL_ACCURACY_TARGET=0.85
CHECK_INTERVAL_MS=300000

# ML Configuration
ML_MODEL_PATH=./ml/models/signal_model.pkl
USE_ML_PREDICTIONS=true
ML_SERVER_URL=http://localhost:8000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@awase-synthetics.com

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log