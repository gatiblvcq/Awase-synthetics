# App Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=awase_synthetics
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Deriv API
DERIV_API_KEY=your_deriv_api_key
DERIV_API_SECRET=your_deriv_api_secret
DERIV_APP_ID=your_deriv_app_id
DERIV_SERVER=green.derivws.com

# Redis (for caching and real-time updates)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Signal Settings
SIGNALS_PER_DAY_MIN=5
SIGNALS_PER_DAY_MAX=30
SIGNAL_ACCURACY_TARGET=0.85
UPDATE_INTERVAL=300000

# ML Model
ML_MODEL_PATH=./ml/models/signal_model.pkl
USE_ML_PREDICTIONS=true

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log